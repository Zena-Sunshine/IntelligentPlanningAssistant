# Copy to `.env` in this directory. Do not commit the real key.
# 有 Key 时 Agent Runtime 走通义千问；没有 Key 时自动离线，本地演示不受影响。

MODEL_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-turbo
VOYAGEIQ_AGENT_PROVIDER=auto
VOYAGEIQ_AGENT_LLM_MODEL=qwen-turbo
# VOYAGEIQ_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI-compatible alternative:
# OPENAI_API_KEY=
# VOYAGEIQ_AGENT_PROVIDER=openai
# VOYAGEIQ_AGENT_LLM_MODEL=gpt-4o-mini
# VOYAGEIQ_AGENT_LLM_BASE_URL=https://api.openai.com/v1
